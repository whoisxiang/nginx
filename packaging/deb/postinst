#!/bin/sh
# postinst for nginx (built from source)
set -e

# 运行用户/组兜底（Ubuntu 的 www-data 来自 base-passwd，正常一定存在）
if ! getent group www-data >/dev/null 2>&1; then
    addgroup --system www-data 2>/dev/null || true
fi
if ! getent passwd www-data >/dev/null 2>&1; then
    adduser --system --ingroup www-data --no-create-home \
            --home /var/lib/nginx --shell /usr/sbin/nologin www-data 2>/dev/null || true
fi

# 运行时目录兜底（被手工删掉也能拉起）
install -d -o www-data -g www-data -m 0755 \
    /var/lib/nginx /var/lib/nginx/tmp \
    /var/lib/nginx/tmp/client_body /var/lib/nginx/tmp/proxy \
    /var/lib/nginx/tmp/fastcgi /var/lib/nginx/tmp/uwsgi /var/lib/nginx/tmp/scgi \
    /var/log/nginx
install -d -m 0755 /etc/nginx/conf.d

if [ -d /run/systemd/system ] && [ "$1" = "configure" ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable nginx.service >/dev/null 2>&1 || true
fi

exit 0
